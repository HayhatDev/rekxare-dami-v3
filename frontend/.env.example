# ── Frontend (Vite) ──
# Required for Supabase Auth (Google OAuth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL (FastAPI)
VITE_API_URL=http://localhost:8000

# Optional script-less analytics (Plausible-compatible JSON beacon).
# Leave unset locally: analytics is a silent no-op without both values.
# VITE_ANALYTICS_HOST=https://plausible.io
# VITE_ANALYTICS_DOMAIN=rekxare-dami.pages.dev
