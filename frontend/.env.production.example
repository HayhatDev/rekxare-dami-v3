# ── Frontend production build env (Vite) ──
# Copy these into the Cloudflare Pages dashboard under
# Settings -> Environment variables (Production), then trigger a build.
# The app lives in the `frontend/` subfolder, so configure:
#   Root directory:  frontend
#   Build command:   pnpm install && pnpm build
#   Output directory: dist
#   Framework preset:  (none needed — it's a static Vite app)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_URL=https://rekxare-dami-api.fastapicloud.dev