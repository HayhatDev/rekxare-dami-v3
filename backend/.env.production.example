# ── Backend production env (set in the Render dashboard) ──
# Create a web service from the Dockerfile, then paste these values under
# Service -> Environment. Keep them out of git.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# MUST match your Cloudflare Pages domain exactly (no trailing slash)
ALLOWED_ORIGINS=https://rekxare-dami.pages.dev

# Required: Render sits behind a reverse proxy; without this, rate limits
# would all key on the proxy's IP instead of the real client.
TRUST_PROXY=true

# Required: backend exits at startup if SUPABASE_SERVICE_ROLE_KEY is missing.
ENVIRONMENT=production